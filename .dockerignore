# CSAT Platform - Docker ignore file
# 
# Exclude files not needed for Docker build to reduce build context size

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
build/
dist/

# Environment files (secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2-*.log

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Git
.git/
.gitignore

# Documentation
README.md
CHANGELOG.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# Misc
*.tsbuildinfo
.eslintcache
.prettierrc
.eslintrc.js
.prettierrc.js
.stylelintrc

# PM2
pm2-*.log
*.pid

# Test
.test-results/
playwright-report/

# Temporary files
tmp/
temp/
*.tmp

# Secrets/Keys (should never be in repo anyway)
*.pem
*.key
*.crt
*.p12
*.pfx
.service-account.json
credentials.json