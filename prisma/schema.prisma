generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Feedback {
  id                String   @id @default(cuid())
  customerName      String?
  customerEmail     String?  @db.VarChar(255)
  category          String?
  location          String?
  servicePlan       String?
  comment           String?  @db.Text
  staffName         String?
  ratings           Json?
  referralSource    String?
  spotlightInterview String?
  serviceDate       String?
  serviceTime       String?
  submissionDate    String?
  timestamp         BigInt   @default(0)
  status            String   @default("new")
  resolutionNotes   String?  @db.Text
  aiAnalysis        Json?
  satisfied         String?
  source            String?
  updatedAt         BigInt?
  createdAt         DateTime @default(now())
  updatedAtDb       DateTime @updatedAt

  @@index([category])
  @@index([timestamp])
  @@index([location])
  @@index([status])
  @@index([customerEmail])
}

model FeedbackToken {
  id            String   @id @default(cuid())
  customerName  String
  customerEmail String   @db.VarChar(255)
  servicePlan   String
  location      String
  serviceDate   String
  sourceEvent   String
  used          Boolean  @default(false)
  createdAt     BigInt
  expiresAt     BigInt
  openedAt      BigInt?
  submittedAt   BigInt?
  eventHash     String?
  category      String?  @default("Reliability")
  staffName     String?

  @@index([customerEmail])
  @@index([used])
  @@index([expiresAt])
  @@index([eventHash])
}

model Customer {
  id                  String   @id @default(cuid())
  customerId          String   @unique
  customerName        String?
  email               String?  @db.VarChar(255)
  billingEmail        String?  @db.VarChar(255)
  phone               String?
  login               String?
  city                String?
  state               String?
  discountPercent     Float?
  splynxDateAdded     BigInt?
  street              String?
  status              String?
  lifecycle           String?
  online              Boolean?
  lastOnlineAt        BigInt?
  lastUpdateAt        BigInt?
  mrrTotal            Float?
  accountType         String?
  category            String?
  servicePlan         String?  @db.Text
  firstSyncedAt       BigInt?
  lastSyncAt          BigInt?
  lastChangeAt        BigInt?
  deleted             Boolean  @default(false)
  reminder15SentAt    BigInt?
  reminder30SentAt    BigInt?
  churnSurveySentAt   BigInt?
  churnSurveyToken    String?
  winBackSentAt       BigInt?
  winBackToken        String?
  churnedAt           BigInt?
  inactiveSince       BigInt?
  blockedSince        BigInt?
  emailOptOut         Boolean  @default(false)
  emailInvalid        Boolean  @default(false)
  overdueInfo         Json?
  // UISP tower (site ancestor) attribution and endpoint match bookkeeping.
  btsId               String?
  btsName             String?
  uispEndpointId      String?
  uispEndpointName    String?
  uispDeviceStatus    String?
  uispOutageCount     Int?
  matchState          String   @default("pending")
  matchMethod         String?
  matchScore          Float?
  matchedAt           BigInt?
  matchUpdatedAt      BigInt?
  // Referral program
  referralCode        String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([lifecycle])
  @@index([city])
  @@index([state])
  @@index([status])
  @@index([customerId])
  @@index([deleted])
  @@index([lastSyncAt])
  @@index([btsId])
  @@index([matchState])
  @@index([referralCode])
}

model Invoice {
  id                String   @id @default(cuid())
  invoiceId         String   @unique
  customerId        String
  number            String?
  title             String?
  total             Float    @default(0)
  dueDate           BigInt?
  date              BigInt?
  status            String?
  isPaid            Boolean  @default(false)
  paidAt            BigInt?
  items             Json?
  reminder15SentAt  BigInt?
  reminder30SentAt  BigInt?
  syncedAt          BigInt?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([customerId])
  @@index([invoiceId])
  @@index([isPaid])
  @@index([dueDate])
  @@index([syncedAt])
}

model SalesRecord {
  id        String   @id @default(cuid())
  region    String
  product   String
  mrr       Float
  nrr       Float
  month     Int
  year      Int
  createdAt DateTime @default(now())

  @@unique([region, product, month, year])
  @@index([region])
  @@index([month, year])
}

// Individual sales records (mirror of the Firestore `sales_records`
// collection). MariaDB is the source of truth; Firestore is a write-only
// best-effort mirror kept for rollback. Timestamps are epoch-ms BigInts for
// parity with the Firestore docs.
model SalesRecordEntry {
  id             String  @id @default(cuid())
  serialNumber   Int
  customerName   String
  location       String
  region         String
  segment        String
  nrc            Float   @default(0)
  mrc            Float   @default(0)
  planCode       String
  saleDate       String  @default("")
  quarter        String
  month          String  @default("")
  packageType    String  @default("Outright")
  salesAgent     String  @default("")
  meansOfSale    String  @default("")
  accountStatus  String  @default("Active")
  statusNotes    String  @default("")
  importBatchId  String  @default("")
  customerType   String  @default("new")
  revivedByAgent String  @default("")
  bts            String  @default("")
  deletedAt      BigInt?
  createdAt      BigInt  @default(0)
  updatedAt      BigInt  @default(0)

  @@index([region, accountStatus])
  @@index([salesAgent])
  @@index([importBatchId])
  @@index([serialNumber])
  @@index([month])
}

// Monthly sales targets (mirror of the Firestore `sales_targets` collection).
model SalesTarget {
  id              String  @id @default(cuid())
  month           String // YYYY-MM
  region          String?
  agentName       String?
  targetRevenue   Float
  targetCustomers Int
  createdAt       BigInt  @default(0)
  updatedAt       BigInt  @default(0)

  @@index([month])
}

// CSV import metadata (mirror of the Firestore `sales_imports` collection).
model SalesImport {
  id          String  @id @default(cuid())
  batchId     String  @unique
  source      String  @default("csv_upload")
  fileName    String  @default("")
  recordCount Int     @default(0)
  importedAt  BigInt  @default(0)
  importedBy  String
  status      String  @default("completed")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("editor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model SyncLock {
  id        String   @id @default("splynx-hourly-sync")
  leaseUntil BigInt
  lastRunAt BigInt?
  lastStatus String?
  lastError String?
  lastStats Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChurnSurvey {
  id            String   @id @default(cuid())
  customerId    String
  customerName  String
  customerEmail String
  sentAt        BigInt
  expiresAt     BigInt
  used          Boolean  @default(false)
  submittedAt   BigInt?
  rating        Int?
  reason        String?
  comment       String?  @db.Text
  clientIp      String?
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([used])
  @@index([expiresAt])
}

model Journal {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  status    String   @default("pending")
  error     String?
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model SplynxMeta {
  id        String   @id @default("sync")
  invoicesApiDenied Boolean @default(false)
  deniedAt  BigInt?
  lastInvoiceSyncAt BigInt?
  paymentsMaxId Int?
  paymentsBackfillOffset Int? @default(0)
  paymentsBackfillComplete Boolean @default(false)
  paymentsLastSyncAt BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SplynxPayment {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  customerId    String?
  invoiceId     String?
  amount        Float
  paymentType   String?
  receiptNumber String?
  note          String?  @db.Text
  paidAt        DateTime?
  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([paidAt])
  @@index([customerId])
  @@index([invoiceId])
}

model CreditNote {
  id          String    @id @default(cuid())
  creditId    String    @unique
  customerId  String?
  number      String?
  total       Float
  status      String?
  paymentId   String?
  invoiceLink String?
  dateCreated BigInt?
  paidAt      DateTime?
  items       Json?
  raw         Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([paidAt])
  @@index([customerId])
  @@index([status])
}

model UispSite {
  id            String   @id
  name          String
  type          String
  status        String?
  suspended     Boolean?
  parentId      String?
  parentName    String?
  // Nearest type=site ancestor (the BTS/tower this node hangs under).
  // Endpoints map to their tower; site nodes map to themselves. Null when the
  // node has no type=site ancestor (root customer location).
  btsId         String?
  btsName       String?
  region        String?
  address       String?  @db.VarChar(500)
  latitude      Float?
  longitude     Float?
  deviceCount   Int?
  deviceOutageCount Int?
  ucrmId        String?
  // Contact/note/sla for the matching engine (Leaf B): synced from
  // description.contact/note/sla so customers can match on phone/email.
  contactName   String?   @db.Text
  contactPhone  String?
  contactEmail  String?
  note          String?  @db.Text
  sla           Float?
  lastSyncAt    BigInt
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([parentId])
  @@index([name])
  @@index([btsId])
}

model UispDevice {
  id            String   @id
  siteId        String?
  siteName      String?
  name          String
  role          String?
  category      String?
  model         String?
  modelName     String?
  mac           String?
  hostname      String?
  firmwareVersion String?
  authorized    Boolean  @default(false)
  status        String?
  ipAddress     String?
  cpu           Float?
  downlinkCapacity Float?
  uplinkCapacity Float?
  downlinkUtilization Float?
  uplinkUtilization Float?
  lastSyncAt    BigInt
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([siteId])
  @@index([role])
  @@index([mac])
  @@index([status])
}

model UispMeta {
  id        String   @id @default("sync")
  lastSyncAt BigInt?
  lastStatus String?
  lastError String?
  lastStats Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BTS admin module (was Firestore: bts_customers). Read path is gated by
// BTS_DB=1; writes are MariaDB-first with best-effort Firestore mirrors.
// Support tickets (was Firestore: tickets). DB-first; Firestore mirrors
// best-effort during cutover.
model Ticket {
  id            String   @id @default(cuid())
  ticketNumber  Int
  customerName  String?
  customerPhone String?
  customerEmail String?  @db.VarChar(255)
  location      String?
  region        String?
  bts           String?
  complaintType String?
  description   String?  @db.Text
  createdBy     String?
  assignedTo    String?
  escalatedTo   String?
  status        String?
  createdAt     BigInt?
  assignedAt    BigInt?
  firstResponseAt BigInt?
  escalatedAt   BigInt?
  resolvedAt    BigInt?
  closedAt      BigInt?
  reopenedAt    BigInt?
  reopenedCount Int?
  slaBreached   Boolean?
  resolutionNotes String? @db.Text
  firstTimeFix  Boolean?
  priority      Int?
  delayReasons  Json?
  delayNotes    String?  @db.Text
  followUps     Json?
  createdByAgent String?
  updatedAt     BigInt?
  deletedAt     BigInt?
  lastSyncAt    BigInt?
  createdAtDb   DateTime @default(now())
  updatedAtDb   DateTime @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([assignedTo])
  @@index([deletedAt])
  @@index([createdAt])
}

// Support revenue records (was Firestore: support_revenue).
model SupportRevenue {
  id          String   @id @default(cuid())
  customerName String?
  location    String?
  region      String?
  projectType String?
  saleKind    String?  // Upsell / Cross-sell / New
  assignedSalesRep String?  // Sales rep a referral/revival deal was assigned to
  bandwidthFrom    String?  // Bandwidth upgrade: previous plan
  bandwidthTo      String?  // Bandwidth upgrade: new plan
  items       Json?
  totalAmount Float?
  description String?  @db.Text
  notes       String?  @db.Text
  date        String?
  agentName   String?
  createdAt   BigInt?
  updatedAt   BigInt?
  deletedAt   BigInt?
  lastSyncAt  BigInt?
  createdAtDb DateTime @default(now())
  updatedAtDb DateTime @updatedAt

  @@index([projectType])
  @@index([region])
  @@index([deletedAt])
  @@index([createdAt])
}

// Persisted staff KPI snapshots (was Firestore: staff_kpi_records).
// Id = `${staffId}_${periodStart}` — one row per staff x calendar bucket.
model StaffKpiRecord {
  id             String   @id
  staffId        String
  staffName      String?
  role           String?
  periodStart    BigInt
  periodEnd      BigInt
  ticketsAssigned Int?
  ticketsResolved Int?
  ticketsEscalated Int?
  ticketsReopened Int?
  ticketsClosed  Int?
  avgResolutionTimeHours Float?
  avgFirstResponseTimeHours Float?
  avgTimeToAssignHours Float?
  slaComplianceRate Float?
  firstContactResolutionRate Float?
  customerSatisfactionScore Float?
  avgCustomerSatisfaction Float?
  qualityScore   Float?
  slaBreaches    Int?
  slaBreachRate  Float?
  priority1Resolved Int?
  priority2Resolved Int?
  priority3Resolved Int?
  currentOpenTickets Int?
  avgDailyTickets Float?
  calculatedAt   BigInt?
  lastSyncAt     BigInt?
  createdAtDb    DateTime @default(now())
  updatedAtDb    DateTime @updatedAt

  @@index([staffId])
  @@index([periodStart])
}

// Admin audit trail (was Firestore: sales_audit_log).
model SalesAuditLog {
  id           String   @id @default(cuid())
  action       String
  collection   String
  recordId     String?
  userId       String?
  userEmail    String?
  changes      Json?
  previousState Json?
  metadata     Json?
  timestamp    BigInt
  createdAtDb  DateTime @default(now())
  updatedAtDb  DateTime @updatedAt

  @@index([collection])
  @@index([timestamp])
  @@index([recordId])
}

// Splynx request nonce (was Firestore: splynx_nonces).
model SplynxNonce {
  key         String   @id
  nonce       Int
  updatedAt   BigInt?
  lastSyncAt  BigInt?
  createdAtDb DateTime @default(now())
  updatedAtDb DateTime @updatedAt
}

// Unified reconciliation audit trail for the Splynx/UISP customer matching
// (Leaf D). One row per field-level change or flag raised while reconciling.
model ReconciliationLog {
  id           String   @id @default(cuid())
  kind         String
  recordId     String
  field        String
  beforeValue  Json?
  afterValue   Json?
  action       String
  reason       String?
  createdAt    BigInt
  createdAtDb  DateTime @default(now())
  updatedAtDb  DateTime @updatedAt

  @@index([recordId])
  @@index([kind])
}

// Inbound UISP webhook events (Leaf B). Id is the UISP event id, making
// reprocessing idempotent.
model UispWebhookEvent {
  id           String   @id
  eventType    String?
  payload      Json?
  processedAt  BigInt?
  error        String?
  createdAt    BigInt
  createdAtDb  DateTime @default(now())
}

// Persisted email job audit trail for the BullMQ mailing suite. One row per
// queued email; the worker updates status as the job progresses. `bullJobId`
// links back to the BullMQ job for queue-level debugging.
model EmailJob {
  id            String   @id @default(cuid())
  bullJobId     String?
  campaignId    String?
  type          String
  status        String   @default("pending") // pending/processing/sent/failed/pending_approval/approved/rejected
  customerId    String?
  customerEmail String?  @db.VarChar(255)
  customerName  String?
  payload       Json
  result        Json?
  error         String?  @db.Text
  scheduledAt   BigInt?
  sentAt        BigInt?
  approvedAt    BigInt?
  approvedBy    String?
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([bullJobId])
  @@index([campaignId])
}

model Campaign {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("campaign") // campaign/downtime/notice/other
  subject       String
  html          String?  @db.Text
  text          String   @db.Text
  audienceJson  Json // { type: 'all' } | { type: 'lifecycle'|'city'|'status'|'servicePlan'|'bts', values: string[] }
  audienceCount Int      @default(0)
  status        String   @default("draft") // draft/pending_approval/approved/scheduled/sending/sent/partial/failed/cancelled/rejected
  scheduledAt   BigInt?
  sentAt        BigInt?
  createdBy     String
  submittedBy   String?  // who submitted for review
  submittedAt   BigInt?  // when submitted for review
  approvedAt    BigInt?
  approvedBy    String?
  rejectedAt    BigInt?
  rejectedBy    String?
  rejectionReason String? @db.Text
  error         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Support-team customer reachout & engagement log (replaces the daily
// reachout spreadsheets). One row per logged call/engagement.
// Email tracking events — open pixel and click redirect logs.
model EmailOpenEvent {
  id              String   @id @default(cuid())
  emailJobId      String
  campaignId      String?
  customerEmail   String   @db.VarChar(255)
  userAgent       String?  @db.Text
  ip              String?  @db.VarChar(45)
  openedAt        DateTime @default(now())

  @@index([emailJobId])
  @@index([campaignId])
  @@index([customerEmail])
  @@index([openedAt])
}

model EmailClickEvent {
  id              String   @id @default(cuid())
  emailJobId      String
  campaignId      String?
  customerEmail   String   @db.VarChar(255)
  url             String   @db.Text
  originalUrl     String   @db.Text
  userAgent       String?  @db.Text
  ip              String?  @db.VarChar(45)
  clickedAt       DateTime @default(now())

  @@index([emailJobId])
  @@index([campaignId])
  @@index([customerEmail])
  @@index([clickedAt])
}

// Periodic tower audit snapshots for incident history and trend analysis.
// One row per tower per capture interval (hourly by default).
model TowerAuditSnapshot {
  id              String   @id @default(cuid())
  towerId         String
  towerName       String
  region          String
  capturedAt      DateTime @default(now())
  status          String?
  suspended       Boolean?
  deviceCount     Int?
  deviceOutageCount Int?
  customerCount   Int?
  activeCustomers Int?
  mrrTotal        Float?
  activeMrr       Float?
  healthScore     Int?
  accountTypes    Json?
  servicePlans    Json?

  @@index([towerId, capturedAt])
  @@index([capturedAt])
  @@index([towerName])
}

model EngagementLog {
  id             String    @id @default(cuid())
  customerId     String?   // unified Customer.id when the name matched
  customerName   String
  btsName        String?
  accountStatus  String?   // Active / Inactive (sheet status)
  accountType    String?   // Residential / Retail / SME / Enterprise...
  plan           String?
  region         String?
  phone          String?
  callStatus     String?   // Contacted / No Answer / Not reachable / ...
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  purpose        String?   // Relationship Building / Follow-Up / ...
  feedback       String?   @db.Text
  complaint      String?
  upsellNote     String?   @db.Text
  retentionRisk  String?   // Low / Medium / High
  resolution     String?
  staffName      String    // owning support agent
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([staffName])
  @@index([customerId])
  @@index([lastContactAt])
}

// ─── Revenue Intelligence Engine (Phase 1) ───────────────────────────────

model CustomerHealthScore {
  id              String   @id @default(cuid())
  customerId      String
  score           Int      // 0-100
  tier            String   // healthy/at-risk/churning/critical/lost
  complaintRisk   Int      @default(0) // 0-100
  paymentRisk     Int      @default(0) // 0-100
  deviceRisk      Int      @default(0) // 0-100
  networkRisk     Int      @default(0) // 0-100
  engagementRisk  Int      @default(0) // 0-100
  lifecycleRisk   Int      @default(0) // 0-100
  trend           String?  // improving/stable/declining
  calculatedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([customerId])
  @@index([score])
  @@index([tier])
  @@index([calculatedAt])
}

model UpsellOpportunity {
  id               String   @id @default(cuid())
  customerId       String
  customerName     String?
  type             String   // bandwidth/loyalty/enterprise/bundle
  currentPlan      String?
  suggestedPlan    String?
  revenuePotential Float    // monthly uplift in Naira
  score            Int      // 0-100 fit score
  status           String   @default("new") // new/contacted/converted/declined/expired
  assignedTo       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([score])
}

model RevenueAnomaly {
  id             String   @id @default(cuid())
  type           String   // tower_mrr_drop/regional_churn/agent_performance/collection_drop/complaint_surge
  severity       String   // info/warning/critical
  title          String
  description    String   @db.Text
  entityType     String?  // tower/customer/agent/region
  entityId       String?
  entityName     String?
  metricName     String
  metricValue    Float
  threshold      Float
  status         String   @default("new") // new/acknowledged/resolved/ignored
  acknowledgedBy String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

// ─── Referral Program (Phase 2) ────────────────────────────────────────

model ReferralProgram {
  id              String   @id @default(cuid())
  referrerId      String   // Customer.id of referrer
  referralCode    String   @unique
  refereeId       String?  // Customer.id of referee (filled on signup)
  refereeName     String?  // name of referred customer
  refereePhone    String?  // phone of referred customer
  status          String   @default("active") // active/completed/expired
  rewardAmount    Float    @default(5000)
  rewardType      String   @default("credit") // credit/discount/free_month
  rewardFulfilled Boolean  @default(false)
  source          String?  // how the referral was shared (whatsapp/sms/in-person)
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([referrerId])
  @@index([referralCode])
  @@index([status])
  @@index([createdAt])
}

// ─── Monthly Reporting Pack (03_Customer_Experience workbook) ───────────
// Persists each month's computed workbook so "Previous Month" / "YTD"
// columns survive across exports, and admin-entered Target / Comment /
// Action / Owner edits are not lost between sessions.
model MonthlySnapshot {
  id         String   @id @default(cuid())
  month      String   @unique // "2026-08"
  workbook03 Json     // KPI rows + complaint breakdown for 03_Customer_Experience
  workbook01 Json?
  workbook02 Json?
  workbook04 Json?
  savedBy    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Paystack transaction cache — one row per Paystack reference. Success-only.
// Synced on demand for monthly revenue reconciliation (splynx sales + paystack collections).
model PaystackTransaction {
  id            String   @id @default(cuid())
  paystackId    String   @unique
  reference     String   @unique
  amount        Int      // kobo (divide by 100 for Naira)
  currency      String   @default("NGN")
  status        String   // success / failed / abandoned
  channel       String?  // card / bank / ussd / mobile_money
  customerEmail String?
  customerName  String?
  gatewayResponse String? @db.Text
  paidAt        DateTime?
  // Golden join key: Splynx customer id from Paystack metadata.customer_id
  // (portal.iwn.ng splynx_paystack_addon). Backfilled from raw.metadata.
  splynxCustomerId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  raw           Json?
  feesNaira      Float?
  netNaira       Float?
  refundedNaira  Float?   @default(0)
  disputeStatus  String?

  @@index([status])
  @@index([paidAt])
  @@index([customerEmail])
  @@index([splynxCustomerId])
  @@index([reference])
  @@index([channel])
}

model SplynxIncomeLedger {
  id             String    @id @default(cuid())
  source         String
  sourceId       String?
  customerId     String?
  customerName   String?
  customerEmail  String?
  reference      String?
  amountNaira    Float
  currency       String    @default("NGN")
  productSegment String?
  region         String?
  taxNaira       Float?    @default(0)
  discountNaira  Float?    @default(0)
  paidAt         DateTime?
  raw            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Natural key: one ledger row per Splynx source record.
  @@unique([source, sourceId])
  @@index([source])
  @@index([reference])
  @@index([customerEmail])
  @@index([paidAt])
}

model PaystackReconciliationLink {
  id                  String   @id @default(cuid())
  paystackReference   String
  splynxLedgerId      String?
  method              String
  confidence          Float
  paystackAmountNaira Float
  splynxAmountNaira   Float?
  varianceNaira       Float?
  status              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paystackReference])
  @@index([splynxLedgerId])
  @@index([status])
  @@index([method])
}

model ReconciliationException {
  id                String    @id @default(cuid())
  kind              String
  paystackReference String?
  splynxLedgerId    String?
  title             String
  detail            String?   @db.Text
  amountNaira       Float?
  ownerEmail        String?
  status            String    @default("open")
  followUpAt        DateTime?
  history           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Natural key for dedupe: one exception per (kind, paystackReference, splynxLedgerId).
  @@unique([kind, paystackReference, splynxLedgerId])
  @@index([kind])
  @@index([status])
  @@index([ownerEmail])
  @@index([followUpAt])
}

model PaystackSavedView {
  id         String @id @default(cuid())
  name       String
  ownerEmail String
  scope      String
  filters    Json
  grouping   String?
  metric     String?
  mode       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerEmail])
  @@index([scope])
}

model PaystackMonthlySnapshot {
  id            String  @id @default(cuid())
  month         String  @unique
  totals        Json
  channels      Json?
  regions       Json?
  segments      Json?
  reconciliation Json?
  exceptions    Json?
  savedBy       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Editable Customer Risk Register rows. One per customer — latest state wins.
// Derived fields (risk level, reason) are recomputed on read; the editable
// fields (action taken, outcome, next review, owner) persist here.
model RiskRegisterEntry {
  id           String   @id @default(cuid())
  customerId   String   @unique
  customerName String?
  mrr          Float?
  riskLevel    String?  // High / Medium / Low (derived, stored for reference)
  reason       String?  @db.Text
  actionTaken  String?  @db.Text
  outcome      String?  @db.Text
  nextReview   String?  // ISO date string, free-form for flexibility
  owner        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
